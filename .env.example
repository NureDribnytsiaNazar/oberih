# Скопіюйте цей файл у .env і за потреби змініть значення.
# Файл .env не потрапляє до репозиторію.

POSTGRES_USER=oberih
POSTGRES_PASSWORD=oberih_dev_password
POSTGRES_DB=oberih
POSTGRES_PORT=5432

# Рядок підключення серверної частини до бази даних (локальна розробка)
DATABASE_URL=postgresql+psycopg://oberih:oberih_dev_password@localhost:5432/oberih

# Секрет для підпису токенів доступу (JWT). Згенеруйте власне випадкове значення:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Фоновий виконавець таймерів (затримки, недоступні вузли, сертифікати)
# WORKER_ENABLED=true
# WORKER_INTERVAL_S=5
# PURGE_INTERVAL_H=24

# Каталоги резервних копій і центру сертифікації (відносно server/, поза git)
# BACKUP_DIR=backups
# CA_DIR=ca

# Хронологія інциденту: template (за замовчуванням) або external (заглушка)
# SUMMARY_PROVIDER=template
