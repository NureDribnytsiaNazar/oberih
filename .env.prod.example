# Параметри розгортання (docker-compose.prod.yml). Скопіюйте у .env.prod
# (файл не потрапляє в git) і задайте секрети на машині розгортання:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   # пароль БД
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # JWT_SECRET
# Скрипт deploy/init-env.ps1 робить це автоматично.

POSTGRES_USER=oberih
POSTGRES_DB=oberih
POSTGRES_PASSWORD=
# Не менше 32 символів (застосунок не стартує з коротшим).
JWT_SECRET=

# Порти Nginx на машині розгортання.
HTTP_PORT=80
HTTPS_PORT=443

# Фоновий виконавець і хронологія інцидентів.
WORKER_INTERVAL_S=5
PURGE_INTERVAL_H=24
SUMMARY_PROVIDER=template
